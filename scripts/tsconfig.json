{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "../dist-scripts",
    "noEmit": false,
    "verbatimModuleSyntax": false,
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  "include": ["./**/*.ts", "../src/types/*.ts", "../src/data/*.ts", "../src/lib/directions.ts"]
}
